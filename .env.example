# Copy to .env for local Docker or the API process. Do not commit real values.
DATABASE_URL=postgresql+psycopg://harbor:set-a-password@localhost:5432/harbor
POSTGRES_PASSWORD=set-a-password
JWT_SECRET=replace-with-a-long-random-string
APP_BASE_URL=http://127.0.0.1:8080
COOKIE_SECURE=false

# Optional. One email=password pair per line. Used only to create accounts that do not exist yet.
HARBOR_SEED_PASSWORDS=

# Optional. Without these, admins copy invitation and reset links from the app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
